
@model CRUD.Models.CustomerCreate
@{
    ViewBag.Title = "Create Customer";
}

<h2>Customer Form</h2>
<form action="/Customer/Create" method="post">
    <div class="form-group">
        <label>Name</label>
        <input type="text" name="Name" class="form-control" value="@Model.Name" placeholder="Enter Your Name" />
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })

    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="your@example.com" />
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        <label>Phone</label>
        <input type="text" name="Phone" class="form-control" value="@Model.Phone" placeholder="Enter Your Phone" />
        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
    </div>
    <br />
    <div class="form-group">
        <button type="submit" class="btn btn-primary" style="width:100px;">Save</button>
    </div>

</form>



@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}